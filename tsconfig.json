{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"@/*": ["./src/*"],
			"styled-system/*": ["./node_modules/.panda/styled-system/*"]
		},
		"types": ["unplugin-icons/types/solid"]
	}
}
